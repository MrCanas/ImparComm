# Supabase (mismo proyecto que icam web dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres, solo para `npm run db:migrate`. La conexión directa de Supabase es
# solo IPv6: en la mayoría de redes hace falta el pooler.
DATABASE_URL=
DATABASE_POOLER_URL=

# Sesión: el MISMO valor que en icam (mismos usuarios y contraseñas)
AUTH_JWT_SECRET=

# Crons (fases siguientes)
CRON_SECRET=

# Microsoft Graph, app-only (mismo registro de Entra que icam).
# Permisos de aplicación: Calendars.Read (captura), Mail.Read (firmas), Mail.Send (resumen).
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Buzón remitente del email semanal
EMAIL_FROM=

# Zoho CRM v8, centro de datos UE (fase 4)
ZOHO_ACCOUNTS_URL=
ZOHO_API_DOMAIN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Valor del picklist Member_Status de Campaigns para «Contactado» (por defecto "Contacted")
ZOHO_MEMBER_STATUS_CONTACTADO=

# Interruptores de integraciones (todas apagadas por defecto; "1" para encender)
CALENDARIO_ENABLED=
FIRMAS_ENABLED=
ZOHO_SYNC_ENABLED=
RESUMEN_SEMANAL_ENABLED=
# URL pública (enlaces del email y webhook de Graph). En Vercel se deduce sola.
APP_URL=
